@layer utilities {
    body,
    html {
        @apply font-body leading-relaxed text-base font-normal not-italic bg-white scroll-smooth w-full wrap-break-word tracking-tight 2xl:text-[.9vw] text-green-dark;
        text-rendering: optimizeSpeed;
    }

    section {
        @apply relative;
    }

    .scrollbar {
        &::-webkit-scrollbar {
            @apply w-1;
        }
        &::-webkit-scrollbar-track {
            @apply bg-gray-lighter;
        }
        &::-webkit-scrollbar-thumb {
            @apply bg-green-dark rounded-md;
        }
        &::-webkit-scrollbar-thumb:hover {
            @apply cursor-grab;
        }
    }

    a,
    button,
    input {
        @apply outline-offset-2 focus-visible:outline-1 focus-visible:outline-black;
    }

    /* kill the browser autofill light-blue/yellow background, keep fields transparent */
    input:-webkit-autofill,
    input:-webkit-autofill:hover,
    input:-webkit-autofill:focus,
    textarea:-webkit-autofill,
    select:-webkit-autofill {
        -webkit-text-fill-color: var(--color-black);
        caret-color: var(--color-black);
        transition: background-color 9999s ease-in-out 0s;
    }

    .cover {
        @apply absolute z-0 inset-0 object-cover w-full h-full;
    }

    .swiper-scrollbar {
        @apply relative! overflow-hidden! left-auto! bottom-auto! top-auto! w-full! h-1! bg-gray-lightest! rounded-xl! mt-6;

        div {
            @apply bg-green-dark!;

            &:after {
                @apply content-[''] absolute top-0 right-0 w-screen h-full bg-green-dark;
            }
        }
    }
}