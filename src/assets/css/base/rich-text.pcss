@layer utilities {
    .rich-text {
        @apply flex flex-col gap-6 text-base lg:text-lg leading-relaxed;

        b,
        strong {
            @apply font-semibold;
        }

        & > * {
            &:first-child {
                @apply mt-0;
            }

            &:last-child {
                @apply mb-0;
            }
        }

        a:not([class]) {
            @apply relative inline-flex overflow-hidden w-fit;

            &:before {
                @apply content-[''] absolute bottom-0 left-0 w-full h-px bg-current;
            }
    
            &:after {
                @apply content-[''] absolute z-2 bottom-0 left-0 w-full h-px bg-white -translate-x-full duration-600 transition-transform;
            }
    
            &:hover,
            &:focus-visible {
                &:after {
                    @apply translate-x-full;
                }
            }
        }

        ul {
            @apply relative pl-1;
    
            li {
                @apply block relative pl-4 mb-1;
    
                &:before {
                    @apply content-[''] w-1 min-w-1 h-1 bg-current absolute left-0 top-3.5;
                }
            }
        }

        ol {
            @apply relative pl-1 list-decimal;
            counter-reset: section;

            li {
                @apply block relative pl-4 mb-1;

                &:before {
                    @apply content-[counter(section)] absolute left-0 top-1 font-heading text-[.75em];
                    counter-increment: section;
                }
            }
        }

        p {
            @apply leading-relaxed;
        }

        h1 {
            @apply font-bold font-heading text-4xl md:text-[2.5rem] lg:text-5xl xl:text-[3.5rem] 2xl:text-6xl 2xl:leading-[1.1];
        }

        h2 {
            @apply font-bold font-heading text-2xl md:text-3xl xl:text-4xl;
        }

        h3 {
            @apply font-bold font-heading text-xl lg:text-2xl xl:text-3xl;
        }

        h4 {
            @apply font-bold font-heading text-lg md:text-xl lg:text-2xl leading-relaxed;
        }

        h5,
        h6 {
            @apply font-bold font-heading text-lg lg:text-xl leading-relaxed;
        }
    
        h1,
        h2,
        h3,
        h4,
        h5,
        h6 {
            &:not(:first-child) {
                @apply mt-10;
            }
        }
    }
}