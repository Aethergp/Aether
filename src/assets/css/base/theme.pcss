@theme {
    /* fonts */
    --font-body: 'Syne', sans-serif;
    --font-heading: 'Inter', sans-serif;

    /* colors */
    --color-pure-white: #fff;
    --color-white: #fffcf9;
    --color-gray-lightest: #f3f3f3;
    --color-gray-lighter: #c9c9c9;
    --color-gray-light: #A9acb5;
    --color-gray-medium: #666;
    --color-gray-dark: #363b46;
    --color-black: #1d1d1b;
    --color-pure-black: #000;

    --color-green-dark: #555328;
    --color-green-pale: #D3D4AB;
    --color-green-light: #E0E6A1;

    --color-green-dark--20: #55532820;

    /* Brand palette (manual). The live greens map to the brand names:
       green-dark = Olive, green-light = Citron. Cream / Beige / Burgundy / Burnt / Cyan
       hexes are ESTIMATED from the palette swatch image - confirm exact values with the client.
       Sapphire and Navy-mid (Azul Sereno) are the documented Bio+ complementary tones. */
    --color-cream: #F0ECCB;     /* estimated - confirm */
    --color-citron: #E0E6A1;    /* = green-light */
    --color-olive: #555328;     /* = green-dark */
    --color-beige: #DDB295;     /* estimated - confirm */
    --color-burgundy: #6B1C2A;  /* estimated - confirm */
    --color-burnt: #3A1014;     /* estimated - confirm */
    --color-cyan: #7E94A1;      /* estimated - confirm */
    --color-navy-mid: #323F70;
    --color-sapphire: #01083A;
    --color-light-blue: #AECBEC; /* derived Bio+ UI tint (text/icons on navy), confirm */
    --color-wine: #411c20;      /* dark red-brown - replaces green for text on /sobre/ict-aether-bio */
    --color-wine--20: #3D010820;

    /* breakpoints matching bootstrap grid */
	--breakpoint-xs: 26.25rem; /* 420px */
	--breakpoint-sm: 36rem; /* 576px */
	--breakpoint-md: 48rem; /* 768px */
	--breakpoint-lg: 62rem; /* 992px */
	--breakpoint-xl: 75rem; /* 1200px */
	--breakpoint-2xl: 87.5rem; /* 1400px */
}

:root {
    --vh: 1vh;
}